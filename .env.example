# URL base del backend Civium (Ktor). Debe terminar en "/".
VITE_API_BASE_URL=https://api.civium.app/

# API key de Google Maps JavaScript API (restringida por dominio/HTTP referrer
# en Google Cloud Console). Puede ser la misma key del proyecto de GCP que ya
# usa la app Android, o una nueva restringida a este dominio.
VITE_GOOGLE_MAPS_API_KEY=
